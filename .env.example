# Local-only defaults. Change both passwords before exposing this on a NAS or network.
ERPNEXT_TAG=version-15
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=admin

# Filled in by: scripts/dev.sh keys
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Optional. Bot token from @BotFather; allowed chat ids are comma-separated.
# The bot ignores every chat not listed here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
